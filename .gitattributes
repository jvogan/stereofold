# Generated documents are binary artifacts; preserve their bytes.
*.pdf binary
# Keep pinned molecular coordinates byte-for-byte, including source padding.
*.cif -text whitespace=-blank-at-eol
*.pdb -text whitespace=-blank-at-eol

# Runtime build stamps identify exact bytes, including bundled Mol* shader text.
plugin/dist/*.html -text whitespace=-blank-at-eol
plugin/dist/*.js -text whitespace=-blank-at-eol
plugin/dist/*.mjs -text whitespace=-blank-at-eol

            ]
          }
        },
        { "kind": "focus", "durationSeconds": 3, "easing": "ease_in_out", "target": { "kind": "ligand" } },
        { "kind": "zoom", "durationSeconds": 3, "easing": "ease_in_out", "magnification": 3.5 }
      ],
      "immersive": {
        "narration": "One pocket up close: histidine F8 holds the iron from below.",
        "appearance": { "representation": "ball-and-stick", "color": "element-symbol", "opacity": 1, "labels": false, "clipping": 0, "fog": 0 },
        "placement": { "translation": [0, 0, 0], "rotation": [0, 0, 0], "scale": 2.2 },
        "emphasis": {
          "parts": [
            { "id": "alpha-1", "label": "Alpha subunit 1", "aliases": ["alpha one", "chain A"], "color": "#4a90e2", "chain": "A", "note": "Chain A, author residues 1-141, one alpha globin." },
            { "id": "heme-a", "label": "Heme in alpha 1", "aliases": ["heme A"], "color": "#e0362c", "chain": "A", "residues": { "from": 142, "to": 142 }, "note": "HEM A 142, the alpha-1 heme." },
            { "id": "his-f8", "label": "Histidine F8", "aliases": ["proximal histidine", "His 87"], "color": "#35c46a", "chain": "A", "residues": { "from": 87, "to": 87 }, "note": "His 87 of chain A, the proximal histidine that coordinates the heme iron." }
          ],
          "focus": ["heme-a", "his-f8"],
          "contextOpacity": 0.1,
          "framing": "fill"
        },
        "motion": { "kind": "orbit", "axis": "x", "degrees": 25, "seconds": 6 }
      }
